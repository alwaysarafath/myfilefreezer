# Copy to .env.local and fill in. Never commit .env.local.

# --- Who may sign in -------------------------------------------------------------
# The whole allow-list. Sign-in with any other Google account is refused.
ALLOWED_EMAIL=you@gmail.com

# Auth.js. Generate the secret with:  openssl rand -base64 32
AUTH_SECRET=
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client (Web application)
# Authorized redirect URI:  http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Skip Google sign-in entirely. Only sensible if nothing but you can reach port 3000.
# DISABLE_AUTH=true

# --- Your bucket -----------------------------------------------------------------
# Region also selects the pricing used for cost estimates.
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Optional --------------------------------------------------------------------
# Where the local index lives. Default: ./data/myfilefreezer.db
# DB_PATH=./data/myfilefreezer.db
